{
  "name": "joud-bird-vr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:determinism": "node scripts/determinism/run.mjs",
    "fixtures": "node scripts/run-ts.mjs scripts/gen-fixtures.ts && node scripts/build-sim.mjs",
    "build:sim": "node scripts/build-sim.mjs",
    "check:mobile": "node scripts/check-mobile-bundle.mjs",
    "sound:samples": "node scripts/sound/render-samples.mjs",
    "preview": "vite preview",
    "rig:shots": "node scripts/run-ts.mjs scripts/rig-shots.ts"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "@supabase/supabase-js": "2.119.2",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.1.0",
    "@iwsdk/reference": "1.1.0",
    "@iwsdk/vite-plugin-dev": "1.1.0",
    "@playwright/test": "1.65.1",
    "@types/three": "^0.185.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
